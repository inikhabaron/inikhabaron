# =============================================================================
# ENVIRONMENT VARIABLE TEMPLATE  (safe to commit — contains NO real values)
# -----------------------------------------------------------------------------
# Copy this file to `.env` for local development and fill in real values.
# In production, set these in Vercel > Project > Settings > Environment Variables.
# NEVER commit the real `.env` file — it is gitignored on purpose.
# NEXT_PUBLIC_* values are exposed to the browser; everything else is server-only.
# =============================================================================

# --- Site ---
# Also used to build absolute article/unsubscribe links in newsletter emails
# (lib/seo/config.js SITE_URL) — no separate SITE_URL var, to avoid the two
# drifting out of sync.
NEXT_PUBLIC_SITE_URL=https://www.inikhabaron.com
NEXT_PUBLIC_BASE_URL=

# --- Database (MongoDB) ---
MONGO_URL=
DB_NAME=

# --- Auth / security ---
JWT_SECRET=
CORS_ORIGINS=

# --- Firebase (client) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Firebase (admin / server) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_ADMIN_CREDENTIALS=

# --- Cloudinary ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments (Razorpay) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
SENDER_EMAIL=
SENDER_NAME=
# Optional: overrides SENDER_NAME/SENDER_EMAIL above with a single
# "Name <email>" from-address string used only for newsletter sends
# (lib/services/newsletter/emailService.js). Falls back to SENDER_NAME +
# SENDER_EMAIL, then a hardcoded default, if unset.
NEWSLETTER_FROM=

# --- Redis (Upstash) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- YouTube ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# --- Analytics ---
NEXT_PUBLIC_GA_ID=

# --- Search engine verification ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
