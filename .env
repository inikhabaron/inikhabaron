# Get these from: https://cloudinary.com/console
# ===========================================
CLOUDINARY_CLOUD_NAME=TODO_ADD_YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=TODO_ADD_YOUR_API_KEY
CLOUDINARY_API_SECRET=TODO_ADD_YOUR_API_SECRET

