# Existing Configuration (DO NOT MODIFY)
MONGO_URL=mongodb://localhost:27017
DB_NAME=newsdesk_db
NEXT_PUBLIC_BASE_URL=https://newsdesk-api.preview.emergentagent.com
CORS_ORIGINS=*

# ===========================================
# TODO: FIREBASE CONFIGURATION
# ===========================================
# Get these from: https://console.firebase.google.com
# Project Settings > General > Your apps > Web app
# ===========================================
NEXT_PUBLIC_FIREBASE_API_KEY=TODO_ADD_YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=TODO_ADD_YOUR_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=TODO_ADD_YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=TODO_ADD_YOUR_PROJECT_ID.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=TODO_ADD_YOUR_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=TODO_ADD_YOUR_APP_ID

# Firebase Admin SDK Service Account (Base64 encoded JSON)
# Download from: Firebase Console > Project Settings > Service Accounts > Generate new private key
# Then base64 encode: cat firebase-admin.json | base64
FIREBASE_ADMIN_CREDENTIALS=TODO_ADD_BASE64_ENCODED_SERVICE_ACCOUNT_JSON

# ===========================================
# TODO: CLOUDINARY CONFIGURATION  
